model ReimbursementExpense {
  id            String                     @id @default(uuid()) @db.Uuid
  title         String
  expenseDate   DateTime                   @map("expense_date") @db.Date
  subtotal      Decimal                    @default(0) @db.Decimal(12, 2)
  tax           Decimal                    @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal                    @map("total_amount") @default(0) @db.Decimal(12, 2)
  currency      String                     @default("BDT")
  category      String
  vendor        String?
  paymentMethod String?                    @map("payment_method")
  projectId     String?                    @map("project_id") @db.Uuid
  taskId        String?                    @map("task_id") @db.Uuid
  subTaskId     String?                    @map("sub_task_id") @db.Uuid
  notes         String?
  receiptUrl    String?                    @map("receipt_url")
  status        ReimbursementExpenseStatus @default(DRAFT)
  createdById   String                     @map("created_by_id") @db.Uuid
  submittedAt   DateTime?                  @map("submitted_at")
  approvedAt    DateTime?                  @map("approved_at")
  rejectedAt    DateTime?                  @map("rejected_at")
  paidAt        DateTime?                  @map("paid_at")
  rejectionNote String?                    @map("rejection_note")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  createdBy     User                       @relation("ReimbursementExpenseCreator", fields: [createdById], references: [id])
  project       Project?                   @relation(fields: [projectId], references: [id])
  task          Task?                      @relation(fields: [taskId], references: [id])
  subTask       SubTask?                   @relation(fields: [subTaskId], references: [id])

  @@index([createdById])
  @@index([projectId])
  @@index([taskId])
  @@index([subTaskId])
  @@index([status])
  @@index([expenseDate])
  @@map("reimbursement_expenses")
}

model InventoryItem {
