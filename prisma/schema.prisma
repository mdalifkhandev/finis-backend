generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model SubscriptionPlan {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  priceMonthly          Float                  @map("price_monthly")
  priceYearly           Float?                 @map("price_yearly")
  stripeProductId       String?                @map("stripe_product_id")
  stripePriceMonthlyId  String?                @map("stripe_price_monthly_id")
  stripePriceYearlyId   String?                @map("stripe_price_yearly_id")
  maxCompanies          Int?                   @map("max_companies")
  maxProjects           Int?                   @map("max_projects")
  maxUsers              Int?                   @map("max_users")
  hasGeofencing         Boolean                @default(false) @map("has_geofencing")
  hasAdvancedReporting  Boolean                @default(false) @map("has_advanced_reporting")
  hasCustomReporting    Boolean                @default(false) @map("has_custom_reporting")
  hasWhiteLabel         Boolean                @default(false) @map("has_white_label")
  supportLevel          String?                @map("support_level")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  subscriptionPurchases SubscriptionPurchase[]
  tenants               Tenant[]

  @@map("subscription_plans")
}

model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  domain                String?                @unique
  planId                String                 @map("plan_id") @db.Uuid
  status                TenantStatus           @default(trial)
  trialEndsAt           DateTime?              @map("trial_ends_at")
  billingEmail          String?                @map("billing_email")
  stripeCustomerId      String?                @map("stripe_customer_id")
  stripeSubscriptionId  String?                @map("stripe_subscription_id")
  stripePriceId         String?                @map("stripe_price_id")
  subscriptionStatus    String?                @map("subscription_status")
  currentPeriodStart    DateTime?              @map("current_period_start")
  currentPeriodEnd      DateTime?              @map("current_period_end")
  planInterval          String?                @map("plan_interval")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  companies             Company[]
  subscriptionPurchases SubscriptionPurchase[]
  plan                  SubscriptionPlan       @relation(fields: [planId], references: [id])
  users                 User[]

  @@map("tenants")
}

model SubscriptionPurchase {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  planId               String           @map("plan_id") @db.Uuid
  planName             String           @map("plan_name")
  stripeSubscriptionId String?          @map("stripe_subscription_id")
  stripePriceId        String?          @map("stripe_price_id")
  interval             String
  amount               Float
  status               PurchaseStatus   @default(active)
  startedAt            DateTime         @default(now()) @map("started_at")
  endedAt              DateTime?        @map("ended_at")
  canceledAt           DateTime?        @map("canceled_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_purchases")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  tenantId                String?                  @map("tenant_id") @db.Uuid
  email                   String                   @unique
  phone                   String?
  passwordHash            String                   @map("password_hash")
  fullName                String                   @map("full_name")
  avatarUrl               String?                  @map("avatar_url")
  role                    UserRole                 @default(worker)
  status                  UserStatus               @default(active)
  lastActiveAt            DateTime?                @map("last_active_at")
  employeeId              String?                  @unique @map("employee_id")
  department              String?
  dateOfBirth             DateTime?                @map("date_of_birth") @db.Date
  address                 String?
  bio                     String?
  hourlyRate              Float?                   @map("hourly_rate")
  joinDate                DateTime?                @map("join_date") @db.Date
  lastLoginAt             DateTime?                @map("last_login_at")
  otp                     String?                  @map("otp")
  otpExpiresAt            DateTime?                @map("otp_expires_at")
  resetToken              String?                  @map("reset_token")
  resetExpiresAt          DateTime?                @map("reset_expires_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  stripeAccountId         String?                  @map("stripe_account_id")
  stripeAccountStatus     String?                  @default("pending") @map("stripe_account_status")
  attendances             Attendance[]
  companies               Company[]                @relation("CompanyOwner")
  companyMembers          CompanyMember[]
  deviceTokens            DeviceToken[]
  uploadedDocuments       Document[]
  emergencyContacts       EmergencyContact[]
  expenses                Expense[]
  inventoryUsageLogs      InventoryUsageLog[]
  invitationsReceived     Invitation[]             @relation("InvitationReceiver")
  invitationsSent         Invitation[]             @relation("InvitationSender")
  locationLogs            LocationLog[]
  mailboxConversations    Conversation[]           @relation("MailboxManager")
  mailboxMessagesSent     MailboxMessage[]         @relation("MailboxMessageSender")
  messageBlocksReceived   MessageBlock[]           @relation("MessageBlockedUser")
  messageBlocksCreated    MessageBlock[]           @relation("MessageBlocker")
  sentMessages            Message[]                @relation("MessageSender")
  notifications           Notification[]
  payrolls                Payroll[]
  projectMemberships      ProjectMember[]
  quotesCreated           Quote[]
  reimbursementExpenses   ReimbursementExpense[]   @relation("ReimbursementExpenseCreator")
  createdSubTasks         SubTask[]                @relation("SubTaskCreator")
  subscriptionPurchases   SubscriptionPurchase[]
  supportRequestsCreated  SupportRequest[]
  taskAssignees           TaskAssignee[]           @relation("TaskAssigneeUser")
  taskReports             TaskReport[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  threadParticipants      ThreadParticipant[]
  timeAdjustments         TimeAdjustmentRequest[]
  certifications          UserCertification[]
  userSettings            UserSettings?
  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id])
  workScheduleAssignments WorkScheduleAssignment[]
  managedWorkers          WorkerManagerMap[]       @relation("ManagerWorkers")
  myManager               WorkerManagerMap?        @relation("WorkerManager")

  @@map("users")
}

model WorkerManagerMap {
  id        String @id @default(uuid()) @db.Uuid
  managerId String @map("manager_id") @db.Uuid
  workerId  String @unique @map("worker_id") @db.Uuid
  manager   User   @relation("ManagerWorkers", fields: [managerId], references: [id])
  worker    User   @relation("WorkerManager", fields: [workerId], references: [id])

  @@map("worker_manager_map")
}

model MessageBlock {
  id            String   @id @default(uuid()) @db.Uuid
  blockerId     String   @map("blocker_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  blockedUser   User     @relation("MessageBlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker       User     @relation("MessageBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@map("message_blocks")
}

model EmergencyContact {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  fullName     String  @map("full_name")
  relationship String?
  phone        String?
  email        String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model UserCertification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  name        String
  issuedBy    String?             @map("issued_by")
  issuedAt    DateTime?           @map("issued_at") @db.Date
  expiresAt   DateTime?           @map("expires_at") @db.Date
  status      CertificationStatus @default(active)
  documentUrl String?             @map("document_url")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_certifications")
}

model UserSettings {
  id                     String  @id @default(uuid()) @db.Uuid
  userId                 String  @unique @map("user_id") @db.Uuid
  language               String  @default("en")
  timezone               String  @default("UTC")
  dateFormat             String  @default("MM/DD/YYYY") @map("date_format")
  currency               String  @default("USD")
  notifyProjectUpdates   Boolean @default(true) @map("notify_project_updates")
  notifySafetyAlerts     Boolean @default(true) @map("notify_safety_alerts")
  notifyWorkforceUpdates Boolean @default(false) @map("notify_workforce_updates")
  notifyFinancialReports Boolean @default(true) @map("notify_financial_reports")
  pushEnabled            Boolean @default(true) @map("push_enabled")
  pushSound              Boolean @default(true) @map("push_sound")
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  senderId   String           @map("sender_id") @db.Uuid
  receiverId String?          @map("receiver_id") @db.Uuid
  email      String?
  phone      String?
  role       UserRole
  status     InvitationStatus @default(pending)
  token      String           @unique
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  receiver   User?            @relation("InvitationReceiver", fields: [receiverId], references: [id])
  sender     User             @relation("InvitationSender", fields: [senderId], references: [id])

  @@map("invitations")
}

model Company {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String?                @map("tenant_id") @db.Uuid
  ownerId        String                 @map("owner_id") @db.Uuid
  name           String
  industry       String?
  description    String?
  phone          String?
  email          String?
  website        String?
  address        String?
  logoUrl        String?                @map("logo_url")
  revenue        Float?
  projectLevel   String?                @map("project_level")
  isActive       Boolean                @default(true) @map("is_active")
  shareToken     String?                @unique @map("share_token")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  owner          User                   @relation("CompanyOwner", fields: [ownerId], references: [id])
  tenant         Tenant?                @relation(fields: [tenantId], references: [id])
  certifications CompanyCertification[]
  members        CompanyMember[]
  contacts       Contact[]
  documents      Document[]
  payrolls       Payroll[]
  projects       Project[]

  @@map("companies")
}

model CompanyMember {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  joinedAt  DateTime @default(now()) @map("joined_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@map("company_members")
}

model CompanyCertification {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  name        String
  issuedBy    String?             @map("issued_by")
  issuedAt    DateTime?           @map("issued_at") @db.Date
  expiresAt   DateTime?           @map("expires_at") @db.Date
  status      CertificationStatus @default(active)
  documentUrl String?             @map("document_url")
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_certifications")
}

model Contact {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  fullName  String  @map("full_name")
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Project {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @map("company_id") @db.Uuid
  managerId             String?                @map("manager_id") @db.Uuid
  name                  String
  type                  ProjectType?
  startDate             DateTime?              @map("start_date") @db.Date
  endDate               DateTime?              @map("end_date") @db.Date
  budget                Float?
  spent                 Float?
  remaining             Float?
  location              String?
  description           String?
  status                ProjectStatus          @default(planning)
  priority              String?
  isWholeHouse          Boolean                @default(false) @map("is_whole_house")
  houseSections         String[]               @default([]) @map("house_sections")
  numFloors             Int?                   @map("num_floors")
  numFloorsMin          Int?                   @map("num_floors_min")
  numFloorsMax          Int?                   @map("num_floors_max")
  roomsPerFloor         Int?                   @map("rooms_per_floor")
  unitPerFloor          Int?                   @map("unit_per_floor")
  unitPerFloorMin       Int?                   @map("unit_per_floor_min")
  unitPerFloorMax       Int?                   @map("unit_per_floor_max")
  progress              Float?                 @default(0)
  shareToken            String?                @unique @map("share_token")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  attendanceSessions    AttendanceSession[]
  documents             Document[]
  expenses              Expense[]
  floors                Floor[]
  geofences             Geofence[]
  inventoryItems        InventoryItem[]
  payrolls              Payroll[]
  teamMembers           ProjectMember[]
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reimbursementExpenses ReimbursementExpense[]
  tasks                 Task[]

  @@map("projects")
}

model Quote {
  id              String             @id @default(uuid()) @db.Uuid
  createdById     String             @map("created_by_id") @db.Uuid
  workItemId      String?            @map("work_item_id") @db.Uuid
  workCategoryId  String?            @map("work_category_id") @db.Uuid
  projectType     String             @map("project_type")
  propertyType    String             @map("property_type")
  unitType        String             @map("unit_type")
  title           String
  quantity        Float              @default(1)
  unit            String?
  measurementType String?            @map("measurement_type")
  unitPrice       Float              @default(0) @map("unit_price")
  subtotal        Float              @default(0)
  notes           String?
  isCustom        Boolean            @default(false) @map("is_custom")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  workCategory    QuoteWorkCategory? @relation(fields: [workCategoryId], references: [id])
  workItem        QuoteWorkItem?     @relation(fields: [workItemId], references: [id])

  @@index([projectType, propertyType, unitType])
  @@index([workCategoryId])
  @@index([workItemId])
  @@map("quotes")
}

model QuoteWorkCategory {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  workItems   QuoteWorkItem[]
  quotes      Quote[]

  @@index([isActive, sortOrder])
  @@map("quote_work_categories")
}

model QuoteWorkItem {
  id              String            @id @default(uuid()) @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  projectType     String            @map("project_type")
  propertyType    String            @map("property_type")
  unitType        String            @map("unit_type")
  name            String
  measurementType String            @map("measurement_type")
  unitCost        Float?            @map("unit_cost")
  isActive        Boolean           @default(true) @map("is_active")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  category        QuoteWorkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quotes          Quote[]

  @@unique([categoryId, projectType, propertyType, unitType, name])
  @@index([categoryId, isActive, sortOrder])
  @@index([projectType, propertyType, unitType, isActive])
  @@map("quote_work_items")
}

model QuoteMeasurementType {
  id        String   @id @default(uuid()) @db.Uuid
  value     String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("quote_measurement_types")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String?
  managerId String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Floor {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  name        String
  floorNumber Int         @map("floor_number")
  status      FloorStatus @default(pending)
  progress    Float?      @default(0)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskFloors  TaskFloor[]
  tasks       Task[]
  units       Unit[]

  @@map("floors")
}

model Unit {
  id            String         @id @default(uuid()) @db.Uuid
  floorId       String         @map("floor_id") @db.Uuid
  name          String
  type          String?
  sizeSqft      Float?         @map("size_sqft")
  status        RoomStatus     @default(pending)
  progress      Float?         @default(0)
  subTaskUnits  SubTaskUnit[]
  subTasks      SubTask[]
  taskAssignees TaskAssignee[]
  taskUnits     TaskUnit[]
  tasks         Task[]
  floor         Floor          @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@map("units")
}

model Task {
  id                    String                 @id @default(uuid()) @db.Uuid
  projectId             String                 @map("project_id") @db.Uuid
  floorId               String?                @map("floor_id") @db.Uuid
  unitId                String?                @map("unit_id") @db.Uuid
  assignedTo            String?                @map("assigned_to") @db.Uuid
  createdBy             String                 @map("created_by") @db.Uuid
  title                 String
  description           String?
  priority              TaskPriority           @default(medium)
  status                TaskStatus             @default(pending)
  approvalDecision      ReviewDecision         @default(pending) @map("approval_decision")
  approvalReviewedBy    String?                @map("approval_reviewed_by") @db.Uuid
  approvalReviewedAt    DateTime?              @map("approval_reviewed_at")
  approvalNotes         String?                @map("approval_notes")
  completionDecision    ReviewDecision         @default(pending) @map("completion_decision")
  completionReviewedBy  String?                @map("completion_reviewed_by") @db.Uuid
  completionReviewedAt  DateTime?              @map("completion_reviewed_at")
  completionNotes       String?                @map("completion_notes")
  allowSubTaskCreation  Boolean                @default(false) @map("allow_sub_task_creation")
  dueDate               DateTime?              @map("due_date") @db.Date
  estimatedHours        Int?                   @map("estimated_hours")
  actualHours           Float?                 @map("actual_hours")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  expenses              Expense?
  reimbursementExpenses ReimbursementExpense[]
  subTasks              SubTask[]
  taskAssignees         TaskAssignee[]         @relation("TaskAssignees")
  taskFloors            TaskFloor[]
  taskInventories       TaskInventory[]
  reports               TaskReport[]
  taskUnits             TaskUnit[]
  assignee              User?                  @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator               User                   @relation("TaskCreator", fields: [createdBy], references: [id])
  floor                 Floor?                 @relation(fields: [floorId], references: [id])
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit                  Unit?                  @relation(fields: [unitId], references: [id])

  @@map("tasks")
}

model SubTask {
  id                    String          @id @default(uuid()) @db.Uuid
  taskId                String          @map("task_id") @db.Uuid
  unitId                String          @map("unit_id") @db.Uuid
  taskAssigneeId        String?         @map("task_assignee_id") @db.Uuid
  createdBy             String          @map("created_by") @db.Uuid
  title                 String
  description           String?
  priority              TaskPriority    @default(medium)
  dueDate               DateTime?       @map("due_date") @db.Date
  estimatedHours        Int?            @map("estimated_hours")
  status                TaskStatus      @default(pending)
  approvalDecision      ReviewDecision  @default(pending) @map("approval_decision")
  approvalReviewedBy    String?         @map("approval_reviewed_by") @db.Uuid
  approvalReviewedAt    DateTime?       @map("approval_reviewed_at")
  approvalNotes         String?         @map("approval_notes")
  approvalAttachmentUrl String?         @map("approval_attachment_url")
  startedAt             DateTime?       @map("started_at")
  submittedAt           DateTime?       @map("submitted_at")
  completedAt           DateTime?       @map("completed_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  expense               Expense?
  subTaskUnits          SubTaskUnit[]
  creator               User            @relation("SubTaskCreator", fields: [createdBy], references: [id])
  taskAssignee          TaskAssignee?   @relation(fields: [taskAssigneeId], references: [id])
  task                  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  unit                  Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  inventories           TaskInventory[]
  reports               TaskReport[]
  reimbursementExpenses ReimbursementExpense[]

  @@index([taskId, unitId])
  @@index([createdBy])
  @@map("sub_tasks")
}

model SubTaskUnit {
  id        String  @id @default(uuid()) @db.Uuid
  subTaskId String  @map("sub_task_id") @db.Uuid
  unitId    String  @map("unit_id") @db.Uuid
  subTask   SubTask @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([subTaskId, unitId])
  @@map("sub_task_units")
}

model TaskFloor {
  id      String @id @default(uuid()) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  floorId String @map("floor_id") @db.Uuid
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, floorId])
  @@map("task_floors")
}

model TaskUnit {
  id          String    @id @default(uuid()) @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") @db.Uuid
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([taskId, unitId])
  @@map("task_units")
}

model TaskAssignee {
  id         String    @id @default(uuid()) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  unitId     String?   @map("unit_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  subTasks   SubTask[]
  task       Task      @relation("TaskAssignees", fields: [taskId], references: [id], onDelete: Cascade)
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
